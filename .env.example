# ====================================================================
# KONFIGURASI BOT RESI TELEGRAM
# ====================================================================

# Token Bot Telegram dari @BotFather (WAJIB DIISI)
BOT_TOKEN=

# PENGAMANAN & WHITELIST AKSES:
# 1. ADMIN_CHAT_ID: ID akun Telegram Anda (pemilik/admin).
#    Admin memiliki izin penuh, termasuk perintah sensitif /reset.
#    Dapat diisi lebih dari 1 ID dipisah koma, contoh: 12345678,87654321
ADMIN_CHAT_ID=

# 2. ALLOWED_GROUP_ID: ID grup Telegram resmi tempat bot digunakan.
#    Hanya anggota grup ini yang dapat mengirim resi dan mengetik /cetak.
#    Dapat diisi lebih dari 1 ID dipisah koma, contoh: -1001234567890,-1009876543210
#    (Cara cek ID grup/user: ketik /id di chat atau di dalam grup)
ALLOWED_GROUP_ID=

# Jadwal penggabungan otomatis (Default: setiap hari jam 14:00 WIB)
# Format cron: menit jam hari-bulan bulan hari-minggu
# Contoh jam 14:00 -> '0 14 * * *'
# Contoh setiap 2 jam -> '0 */2 * * *'
CRON_SCHEDULE=0 14 * * *

# Default Pengirim untuk Label Resi Manual (/manual)
DEFAULT_SIP=SAFRA
DEFAULT_HP=0856-9733-7041

# Nama Printer Fisik untuk Cetak Langsung (Hitam Putih)
PRINTER_NAME=EPSON L3250 Series

# Integrasi Google Sheets Laporan Keuangan (URL Web App dari Google Apps Script)
# Panduan pembuatan URL Web App ada di folder: google_apps_script/Code.gs
GOOGLE_SHEET_WEBHOOK_URL=
